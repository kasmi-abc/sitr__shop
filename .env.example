# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# scrypt hash. Generate with node:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const s=randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=

# Two-factor auth (TOTP). Leave empty to disable 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(20).toString('base64').replace(/=/g,'').replace(/\+/g,'').replace(/\//g,'A').toUpperCase().slice(0,32))"
ADMIN_TOTP_SECRET=

# Marketing pixels (optional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
